{
  "expo": {
    "name": "Learn_Turne",
    "slug": "Learn_Turne",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nous utilisons votre position pour afficher votre emplacement sur la tournée et vous prévenir à l approche d un arrêt avec des colis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/Learn_Turne"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nous utilisons votre position pour afficher votre emplacement sur la tournée et vous prévenir à l approche d un arrêt avec des colis."
        }
      ]
    ]
  }
}
